@model List<YoabTest.Models.TaskModel>

    @{
        Layout = null;
    }

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true"/>
<h2>Lista de tareas</h2>

<!-- Formulario para crear o editar tarea -->
<form asp-action="CreateOrEdit" method="post" id="taskForm">
    <input type="hidden" name="Id" /> 
    <input name="Title" placeholder="Título" />
    <textarea name="Description" placeholder="Descripción"></textarea>
    <input name="Deadline" type="date" id="Deadline" min="@DateTime.Now.ToString("dd-MM-yyyy")" />
    <label>
        <input name="IsImportant" type="checkbox" /> Importante
    </label>
    <button type="submit">Guardar</button>
</form>

<hr />

<!-- Lista de tareas -->
<table>
    <thead>
        <tr>
            <th>Título</th>
            <th>Descripción</th>
            <th>Fecha limite</th>
            <th>Completada</th>
            <th>Importante</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr class="@(task.IsCompleted ? "completed" : "") @(task.IsImportant ? "important" : "")">
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.Deadline.ToString("dd-MM-yyyy")</td>
                <td>
                    <form asp-action="ToggleComplete" method="post">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit">✅</button>
                    </form>
                </td>
                <td>
                    <button type="button"
                            onclick="toggleImportant(@task.Id)"
                            class="@(task.IsImportant ? "important" : "")">
                        @(task.IsImportant ? "★ Importante" : "☆ Importante")
                    </button>
                </td>
                <td>
                    <button onclick="editTask(@task.Id)">Editar</button>
                    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@task.Id" />
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
    
    <script src="~/js/script.js"></script>
