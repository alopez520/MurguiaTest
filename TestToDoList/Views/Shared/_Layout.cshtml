<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>App</title>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>ToDo List </h1>
            <div>
                @* Si el usuario esta autenticado podra ver el contenido y podra acceder a los botones *@
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="me-3">Bienvenido, @User.Identity.Name!</span>
                    <a class="btn btn-outline-danger" href="/Account/Logout">Cerrar Sesión</a>
                }
            </div>
        </div>

        <nav class="mb-3">
          
            @if (User.Identity.IsAuthenticated)
            {
                <a class="btn btn-outline-success" href="/Tareas/Create">Nueva Tarea</a>
            }
            else
            {
                <a class="btn btn-outline-success" href="/Account/Login">Iniciar Sesión</a>
            }
        </nav>

        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>