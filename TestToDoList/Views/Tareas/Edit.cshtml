@model TestToDoList.Models.Tarea

<h2>Editar Tarea</h2>

<form method="post" class="row g-3">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="col-12">
     <label class="form-label">Título</label>
     <input type="text" name="Titulo" value="@Model.Titulo" class="form-control" required />
    </div>
    <div class="col-12">
     <label class="form-label">Descripción</label>
     <textarea name="Descripcion" class="form-control">@Model.Descripcion</textarea>
    </div>

    @* Estatus de prioridad de las tareas *@
    <div class="col-md-4">
        <label class="form-label">Prioridad</label>
        <select name="Prioridad" class="form-select">
            <option value="Alta" selected="@(Model.Prioridad == "Alta")">Alta</option>
            <option value="Media" selected="@(Model.Prioridad == "Media")">Media</option>
            <option value="Baja" selected="@(Model.Prioridad == "Baja")">Baja</option>
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Estatus</label>
        <select name="Estatus" class="form-select">
            <option value="Pendiente" selected="@(Model.Estatus == "Pendiente")">Pendiente</option>
            <option value="En Proceso" selected="@(Model.Estatus == "En Proceso")">En Proceso</option>
            <option value="Completada" selected="@(Model.Estatus == "Completada")">Completada</option>
        </select>
    </div>

  @*   Usuario a quien fue asignado, el administrador puede escoger entre los registros</a>
    El usuario normal solo se puede asignar asi mismo  *@
    <div class="col-md-4">
        <label class="form-label">Usuario Asignado</label>
        @if (User.IsInRole("Admin"))
        {
            <select name="UsuarioAsignado" class="form-select" required>
                @foreach (var usuario in ViewBag.Usuarios)
                {
                <option value="@usuario.Email" selected="@(usuario.Email == Model.UsuarioAsignado)">@usuario.Nombre</option>
                }
            </select>
        }
        else
        {
            <input type="text" name="UsuarioAsignado" value="@Model.UsuarioAsignado" class="form-control" readonly />
        }
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-success">Actualizar</button>
        <a class="btn btn-secondary" href="/Tareas">Cancelar</a>
    </div>
</form>



